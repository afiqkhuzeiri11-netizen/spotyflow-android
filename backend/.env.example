# Default SQLite (langsung jalan tanpa setup tambahan)
DATABASE_URL=sqlite+aiosqlite:///./veloxtube.db

# Untuk produksi PostgreSQL, cukup ganti baris di atas menjadi:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/veloxtube

JWT_SECRET_KEY=ganti-dengan-secret-random-minimal-32-karakter
JWT_EXPIRE_MINUTES=10080

# YouTube Data API v3 Key (opsional; otomatis fallback ke yt-dlp flat search 60-80 hasil jika kosong)
YOUTUBE_API_KEY=

# Google OAuth 2.0 Credentials (untuk Login Google & Sinkronisasi YouTube 2 Arah)
GOOGLE_CLIENT_ID=602927550377-v1dicdufnh5t2l3baq74jlbtg4gold37.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# Opsional: path manual FFmpeg jika tidak berada di PATH sistem
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
